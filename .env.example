# Same values as your spend-stock app — same Supabase project

# Build-time, inlined into the bundle (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Runtime secrets (server-only) — set as encrypted secrets on Cloudflare/Vercel
SUPABASE_SECRET_KEY=your-supabase-secret-key
# 64 hex chars; decrypts the user-supplied Gemini key. Missing it breaks the key save/read route.
API_KEY_ENCRYPTION_SECRET=your-64-hex-char-encryption-secret
