{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haku",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Worker logs in the Cloudflare dashboard (Observability tab) for debugging deploys.
  "observability": { "enabled": true },
  // Smart Placement: worker runs near the user by default, but Supabase is in
  // Singapore. Page renders make several sequential Supabase subrequests (auth +
  // data), so from an India edge that's N x ~70ms RTT. Smart Placement detects the
  // chatty backend and relocates execution near Singapore, collapsing those hops.
  "placement": { "mode": "smart" },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // R2 bucket backing the Next incremental cache (unstable_cache / revalidateTag).
  // Bucket "haku" is created in the Cloudflare dashboard in 64.2; until then
  // `wrangler dev` simulates it locally via miniflare (no real bucket needed).
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "haku"
    }
  ],
  // Durable Object backing the sharded tag cache (revalidateTag invalidation).
  // The DOShardedTagCache class is exported by the generated .open-next/worker.js;
  // the migration creates it on deploy — no dashboard setup, no populate step.
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOShardedTagCache"] }
  ]
}
